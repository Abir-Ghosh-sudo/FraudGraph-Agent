ENVIRONMENT=development
AUTH_ENABLED=false
# Production always requires a secret of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Keep external actions disabled until a real, tested provider is configured.
ALLOW_ACTION_EXECUTION=false

# LLM
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# TigerGraph
TIGERGRAPH_HOST=http://localhost:14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH_NAME=FraudGraph
# Set this to the exact installed TigerGraph query name before enabling it.
TIGERGRAPH_INVESTIGATION_QUERY=

# Agent
AGENT_MAX_STEPS=20
AGENT_ENABLE_HUMAN_APPROVAL=true