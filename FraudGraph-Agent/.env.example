APP_ENV=development

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# TigerGraph
TIGERGRAPH_HOST=http://localhost:14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH=FraudGraph

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fraudgraph

# Redis
REDIS_URL=redis://localhost:6379/0

# Agent
AGENT_MAX_STEPS=20
AGENT_REQUIRE_APPROVAL=true
