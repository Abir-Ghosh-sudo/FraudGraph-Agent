CREATE DIRECTED EDGE PERFORMS(FROM Customer, TO Transaction, timestamp DATETIME) WITH REVERSE_EDGE="PERFORMED_BY";
CREATE DIRECTED EDGE OWNS_CARD(FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY_CUSTOMER";
CREATE DIRECTED EDGE USES_DEVICE(FROM Customer, TO Device, last_used DATETIME) WITH REVERSE_EDGE="USED_BY_CUSTOMER";
CREATE DIRECTED EDGE HAS_ADDRESS(FROM Customer, TO Address) WITH REVERSE_EDGE="ADDRESS_OF";
CREATE DIRECTED EDGE TXN_USES_DEVICE(FROM Transaction, TO Device) WITH REVERSE_EDGE="DEVICE_OF_TXN";
CREATE DIRECTED EDGE TXN_FROM_IP(FROM Transaction, TO IP) WITH REVERSE_EDGE="IP_OF_TXN";
CREATE DIRECTED EDGE TXN_AT_MERCHANT(FROM Transaction, TO Merchant) WITH REVERSE_EDGE="MERCHANT_OF_TXN";
CREATE DIRECTED EDGE TXN_USES_CARD(FROM Transaction, TO Card) WITH REVERSE_EDGE="CARD_OF_TXN";
CREATE DIRECTED EDGE ASSOCIATED_WITH_CASE(FROM Customer, TO Case) WITH REVERSE_EDGE="CASE_CUSTOMER";
CREATE DIRECTED EDGE TXN_IN_CASE(FROM Transaction, TO Case) WITH REVERSE_EDGE="CASE_TXN";
CREATE DIRECTED EDGE MATCHES_PATTERN(FROM Transaction, TO FraudPattern, score DOUBLE) WITH REVERSE_EDGE="PATTERN_MATCHED_TXN";
